{
    "schemes": [
        "https",
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "File sharing service. Upload any file, get a shareable link.",
        "title": "Trove API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "Renders the file upload page",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "ui"
                ],
                "summary": "Upload page",
                "responses": {
                    "200": {
                        "description": "HTML upload page",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/.well-known/agent.json": {
            "get": {
                "description": "Returns structured JSON metadata for AI agent integration",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "discovery"
                ],
                "summary": "Agent discovery metadata",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/cmd_server.AgentJSON"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "Returns service health status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/cmd_server.HealthResponse"
                        }
                    }
                }
            }
        },
        "/llms.txt": {
            "get": {
                "description": "Returns plain-text API documentation for LLM and agent consumption",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "discovery"
                ],
                "summary": "LLM-friendly API documentation",
                "responses": {
                    "200": {
                        "description": "Plain-text API docs",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/mine": {
            "get": {
                "description": "Shows the current user's upload and view history",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "ui"
                ],
                "summary": "User activity dashboard",
                "responses": {
                    "200": {
                        "description": "HTML activity page",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/upload": {
            "post": {
                "description": "Upload a file and get a shareable link. Supports custom slugs and overwriting existing files.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "files"
                ],
                "summary": "Upload a file",
                "parameters": [
                    {
                        "type": "file",
                        "description": "File to upload",
                        "name": "file",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Custom URL slug (lowercase alphanumeric and hyphens, 1-64 chars)",
                        "name": "slug",
                        "in": "formData"
                    },
                    {
                        "type": "string",
                        "description": "Set to 'true' to replace an existing file at the same slug",
                        "name": "overwrite",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/cmd_server.UploadResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/cmd_server.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Slug already taken",
                        "schema": {
                            "$ref": "#/definitions/cmd_server.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/cmd_server.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/{slug}": {
            "get": {
                "description": "Renders an HTML viewer for the uploaded file (markdown, code, images, CSV, HTML, etc.)",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "files"
                ],
                "summary": "View a file",
                "parameters": [
                    {
                        "type": "string",
                        "description": "File slug",
                        "name": "slug",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "HTML viewer page",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "404": {
                        "description": "File not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/{slug}/raw": {
            "get": {
                "description": "Returns the raw file content with its original content type. Supports Range requests.",
                "tags": [
                    "files"
                ],
                "summary": "Download raw file",
                "parameters": [
                    {
                        "type": "string",
                        "description": "File slug",
                        "name": "slug",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "HTTP Range header for partial content",
                        "name": "Range",
                        "in": "header"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "File content",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "206": {
                        "description": "Partial file content",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "404": {
                        "description": "File not found",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "cmd_server.AgentEndpoint": {
            "type": "object",
            "properties": {
                "content_type": {
                    "type": "string",
                    "example": "multipart/form-data"
                },
                "description": {
                    "type": "string",
                    "example": "Upload a file. Returns a shareable URL."
                },
                "example": {
                    "type": "string"
                },
                "method": {
                    "type": "string",
                    "example": "POST"
                },
                "parameters": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/cmd_server.AgentEndpointParam"
                    }
                },
                "path": {
                    "type": "string",
                    "example": "/upload"
                },
                "response_example": {
                    "$ref": "#/definitions/cmd_server.UploadResponse"
                }
            }
        },
        "cmd_server.AgentEndpointParam": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "The file to upload"
                },
                "name": {
                    "type": "string",
                    "example": "file"
                },
                "required": {
                    "type": "boolean",
                    "example": true
                },
                "type": {
                    "type": "string",
                    "example": "file"
                }
            }
        },
        "cmd_server.AgentJSON": {
            "type": "object",
            "properties": {
                "api_base": {
                    "type": "string",
                    "example": "https://trove.labs.staging.gteng.co"
                },
                "description": {
                    "type": "string",
                    "example": "File sharing service. Upload any file, get a shareable link."
                },
                "endpoints": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/cmd_server.AgentEndpoint"
                    }
                },
                "name": {
                    "type": "string",
                    "example": "trove"
                }
            }
        },
        "cmd_server.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "slug already taken"
                }
            }
        },
        "cmd_server.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "cmd_server.UploadResponse": {
            "type": "object",
            "properties": {
                "slug": {
                    "type": "string",
                    "example": "my-report"
                },
                "url": {
                    "type": "string",
                    "example": "https://trove.labs.staging.gteng.co/my-report"
                }
            }
        }
    }
}